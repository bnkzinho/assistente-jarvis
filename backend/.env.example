ANTHROPIC_API_KEY=
# Chave inventada por você — o Mac e o Atalho do iPhone precisam mandar
# essa mesma chave pra poder usar o assistente (evita que estranhos achem
# a URL e fiquem gastando sua cota da API).
JARVIS_SECRET=
CLAUDE_MODEL=claude-sonnet-5
PORT=3000

# Tópico do ntfy.sh pra notificações de lembrete (celular/Mac). Invente
# um nome difícil de adivinhar, tipo "marcia-lembretes-83f2k1" — qualquer
# um que souber o nome exato do tópico recebe suas notificações, já que
# o ntfy não pede login. Veja o README pra instalar o app.
NTFY_TOPIC=

# Pra enviar e-mail (opcional — sem isso, a ferramenta de e-mail só avisa
# que não está configurada). EMAIL_USER é o seu Gmail; EMAIL_APP_PASSWORD
# é uma "senha de app" gerada em myaccount.google.com/apppasswords
# (precisa ter verificação em duas etapas ativada na conta pra aparecer
# essa opção) — NUNCA a senha normal da conta.
EMAIL_USER=
EMAIL_APP_PASSWORD=
