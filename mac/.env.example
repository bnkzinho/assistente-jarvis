# URL do backend depois de publicado (Render, etc) — sem barra no final.
BACKEND_URL=https://seu-backend.onrender.com

# A MESMA chave que você colocou em JARVIS_SECRET no backend.
JARVIS_SECRET=

# Chave da OpenAI, só pra transcrever o áudio (Whisper). Pega em
# platform.openai.com/api-keys — custa centavos por minuto de áudio.
OPENAI_API_KEY=

# Voz do macOS a usar (pt-BR). Pra ver as instaladas: `say -v '?' | grep pt_BR`
JARVIS_VOZ=Luciana

# Quantos segundos esperar o WhatsApp Desktop abrir/carregar a conversa
# antes de apertar Enter sozinha. Se ela mandar antes da conversa certa
# carregar (ex: computador lento, muitas abas), aumenta esse número.
ESPERA_WHATSAPP_SEGUNDOS=3.5
